# Copy to .env for a local API process. Docker Compose sets its own values.
# Leave VITE_API_BASE empty in development so the site server proxies /api to the API.
# VITE_SITE_ORIGIN is the one public host for canonical links, Open Graph URLs, and the sitemap.
# No trailing slash. Leave it empty locally if you do not need absolute URLs.

VITE_API_BASE=
VITE_SITE_ORIGIN=
# SSR_API_BASE=http://127.0.0.1:8000

APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://places:places@localhost:5432/places
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
